<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel — Por do Som</title>
<style>
:root{
  --brand-primary:#a83030;--brand-primary-light:#c84545;--brand-accent:#e8a04a;
  --bg-dark:#0d0707;--bg-darker:#060303;--bg-card:#1a0e0e;--bg-card-hover:#251515;
  --text-primary:#f5ede0;--text-secondary:#b8a89a;--text-muted:#7a6a5e;
  --border:rgba(168,48,48,.25);--border-light:rgba(168,48,48,.12);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Montserrat',system-ui,sans-serif;background:var(--bg-dark);color:var(--text-primary);min-height:100vh}
.hidden{display:none!important}

/* ===== LOGIN ===== */
.login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem}
.login-box{background:var(--bg-card);border:1px solid var(--border);padding:2.5rem;border-radius:8px;max-width:420px;width:100%}
.login-logo{display:flex;align-items:center;gap:.8rem;justify-content:center;margin-bottom:.5rem}
.login-logo img{width:48px;height:48px;border-radius:50%;border:1px solid var(--brand-primary-light)}
.login-logo span{font-weight:800;letter-spacing:3px;font-size:1rem}
.login-sub{text-align:center;color:var(--text-muted);font-size:.72rem;letter-spacing:2px;text-transform:uppercase;margin-bottom:2rem}
.login-box label{display:block;font-size:.68rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-secondary);margin-bottom:.5rem}
.login-box input{width:100%;background:var(--bg-dark);border:1px solid var(--border);color:var(--text-primary);padding:.9rem 1rem;border-radius:4px;font-size:.9rem;font-family:inherit;outline:none}
.login-box input:focus{border-color:var(--brand-primary-light)}
.login-help{margin-top:1rem;font-size:.75rem;color:var(--text-muted);line-height:1.6}
.login-help a{color:var(--brand-accent);text-decoration:none}
.login-help a:hover{text-decoration:underline}
.btn-primary{width:100%;margin-top:1.5rem;background:var(--brand-primary);color:var(--brand-cream,#f5ede0);border:1px solid var(--brand-primary-light);padding:.95rem;border-radius:4px;font-family:inherit;font-size:.78rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.3s}
.btn-primary:hover{background:var(--brand-primary-light)}
.login-error{margin-top:1rem;padding:.8rem;background:rgba(168,48,48,.15);border:1px solid var(--border);color:#f0b0b0;font-size:.8rem;border-radius:4px;display:none}

/* ===== LAYOUT PRINCIPAL ===== */
.layout{display:grid;grid-template-columns:230px 1fr;min-height:100vh}
.sidebar{background:var(--bg-darker);border-right:1px solid var(--border);padding:1.5rem 1rem;display:flex;flex-direction:column;gap:.4rem;position:sticky;top:0;height:100vh}
.sidebar-brand{display:flex;align-items:center;gap:.6rem;padding:.5rem;margin-bottom:1.5rem}
.sidebar-brand img{width:32px;height:32px;border-radius:50%;border:1px solid var(--brand-primary-light)}
.sidebar-brand span{font-weight:800;font-size:.8rem;letter-spacing:2px}
.side-item{display:flex;align-items:center;gap:.7rem;padding:.75rem 1rem;border-radius:4px;color:var(--text-secondary);text-decoration:none;font-size:.78rem;font-weight:600;letter-spacing:.5px;transition:.2s;cursor:pointer;border:none;background:none;font-family:inherit;width:100%;text-align:left}
.side-item:hover{background:var(--bg-card);color:var(--text-primary)}
.side-item.ativo{background:var(--brand-primary);color:#f5ede0}
.side-item .icone{font-size:1rem;width:20px;text-align:center}
.side-footer{margin-top:auto;padding:1rem;border-top:1px solid var(--border-light)}
.side-user{font-size:.7rem;color:var(--text-muted)}
.side-sair{margin-top:.5rem;background:none;border:none;color:#c08080;font-size:.7rem;cursor:pointer;font-family:inherit;padding:0}
.side-sair:hover{color:var(--brand-primary-light);text-decoration:underline}

.main{padding:2rem;max-width:1100px}
.page-title{font-size:1.3rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:.4rem}
.page-sub{font-size:.8rem;color:var(--text-muted);margin-bottom:2rem}

/* ===== CARDS DE RESUMO ===== */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:2.5rem}
.stat-card{background:var(--bg-card);border:1px solid var(--border-light);border-radius:6px;padding:1.2rem 1.4rem}
.stat-num{font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,var(--brand-primary-light),var(--brand-accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.1}
.stat-label{font-size:.62rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-muted);margin-top:.3rem}

/* ===== TABELA DE ÁLBUNS ===== */
.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:1rem;flex-wrap:wrap}
.btn-novo{background:var(--brand-primary);color:#f5ede0;border:1px solid var(--brand-primary-light);padding:.7rem 1.3rem;border-radius:4px;font-family:inherit;font-size:.72rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:.3s}
.btn-novo:hover{background:var(--brand-primary-light)}
.table-wrap{background:var(--bg-card);border:1px solid var(--border-light);border-radius:6px;overflow:hidden}
table{width:100%;border-collapse:collapse}
th{font-size:.6rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-muted);text-align:left;padding:.9rem 1.1rem;border-bottom:1px solid var(--border-light)}
td{padding:.8rem 1.1rem;border-bottom:1px solid var(--border-light);font-size:.82rem;vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--bg-card-hover)}
td img.capa-mini{width:42px;height:42px;border-radius:3px;object-fit:cover;background:var(--bg-darker)}
.sem-capa{width:42px;height:42px;border-radius:3px;background:var(--bg-darker);display:flex;align-items:center;justify-content:center;font-size:1rem;color:var(--text-muted)}
td .titulo-cell{font-weight:700;color:var(--text-primary)}
td .artista-cell{font-size:.72rem;color:var(--text-muted)}
.tag-genero{display:inline-block;font-size:.55rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:.2rem .5rem;margin-right:.25rem;border:1px solid var(--border);color:var(--brand-accent);border-radius:2px}
.destaque-star{color:var(--brand-accent);font-size:.9rem}
.status-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:6px}
.status-ok{background:#5d9871}
.status-publicado{color:#8dbf9f;font-size:.68rem}

/* ===== ESTADOS ===== */
.loading{text-align:center;padding:3rem;color:var(--text-muted);font-size:.85rem}
.vazio{text-align:center;padding:3rem;color:var(--text-muted)}
.vazio .icone{font-size:2.5rem;display:block;margin-bottom:1rem;opacity:.5}
.toast{position:fixed;bottom:1.5rem;right:1.5rem;background:var(--bg-card);border:1px solid var(--brand-primary-light);color:var(--text-primary);padding:1rem 1.5rem;border-radius:6px;font-size:.82rem;z-index:9999;animation:toastIn .3s ease}
@keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

@media(max-width:800px){
  .layout{grid-template-columns:1fr}
  .sidebar{position:static;height:auto;flex-direction:row;flex-wrap:wrap;gap:.4rem}
  .sidebar-brand{width:100%;}
  .side-footer{display:none}
  .main{padding:1.2rem}
}
</style>
</head>
<body>

<!-- ===== TELA DE LOGIN ===== -->
<div class="login-screen" id="login-screen">
  <div class="login-box">
    <div class="login-logo">
      <img src="/pordosom-profile.jpg" alt="Por do Som">
      <span>PÔR DO SOM</span>
    </div>
    <p class="login-sub">Painel de Edição</p>

    <label for="token">Token do GitHub</label>
    <input type="password" id="token" placeholder="ghp_... ou github_pat_..." autocomplete="off">
    <div class="login-error" id="login-error"></div>

    <button class="btn-primary" onclick="entrar()">Entrar no Painel</button>

    <p class="login-help">
      Como gerar seu token (2 minutos):
      <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener">github.com/settings/tokens</a>
      → "Generate new token" → dê o nome "painel-pordosom" → em Repository access, escolha
      <strong>"Only select repositories"</strong> e marque o repositório do site → em Permissions,
      dê permissão de <strong>Contents: Read and write</strong> → Generate → copie o código.
    </p>
  </div>
</div>

<!-- ===== PAINEL PRINCIPAL ===== -->
<div class="layout hidden" id="painel">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <img src="/pordosom-profile.jpg" alt="">
      <span>PÔR DO SOM</span>
    </div>
    <button class="side-item ativo" data-pagina="inicio"><span class="icone">🏠</span> Início</button>
    <button class="side-item" data-pagina="albuns"><span class="icone">💿</span> Álbuns</button>
    <button class="side-item" data-pagina="noticias" onclick="emBreve('Notícias')"><span class="icone">📰</span> Notícias</button>
    <button class="side-item" data-pagina="projetos" onclick="emBreve('Projetos')"><span class="icone">🎬</span> Projetos</button>
    <button class="side-item" data-pagina="audiovisual" onclick="emBreve('Audiovisual')"><span class="icone">🎵</span> Audiovisual</button>
    <button class="side-item" data-pagina="config" onclick="emBreve('Configurações')"><span class="icone">⚙️</span> Configurações</button>
    <div class="side-footer">
      <div class="side-user" id="side-user">—</div>
      <button class="side-sair" onclick="sair()">Sair do painel</button>
    </div>
  </aside>

  <main class="main">
    <!-- PÁGINA INÍCIO -->
    <div id="pagina-inicio">
      <h1 class="page-title">Início</h1>
      <p class="page-sub">Resumo do seu site — conectado ao repositório</p>
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-num" id="stat-albuns">—</div><div class="stat-label">Álbuns no catálogo</div></div>
        <div class="stat-card"><div class="stat-num" id="stat-destaques">—</div><div class="stat-label">Em destaque na home</div></div>
        <div class="stat-card"><div class="stat-num" id="stat-generos">—</div><div class="stat-label">Gêneros ativos</div></div>
      </div>
      <div class="table-wrap" style="padding:1.5rem">
        <p style="font-size:.85rem;color:var(--text-secondary);line-height:1.8">
          💡 <strong>Como funciona:</strong> tudo o que você edita aqui é salvo direto no repositório do seu site.
          Após salvar, o site se atualiza sozinho em 1–2 minutos.
          Na barra lateral, clique em <strong>Álbuns</strong> para começar.
        </p>
      </div>
    </div>

    <!-- PÁGINA ÁLBUNS -->
    <div id="pagina-albuns" class="hidden">
      <div class="toolbar">
        <div>
          <h1 class="page-title">Álbuns</h1>
          <p class="page-sub" style="margin-bottom:0">O catálogo completo — edite, destaque, publique</p>
        </div>
        <button class="btn-novo" onclick="emBreve('Novo álbum')">＋ Novo Álbum</button>
      </div>
      <div class="loading" id="albuns-loading">Carregando álbuns do repositório…</div>
      <div class="table-wrap hidden" id="albuns-table-wrap">
        <table>
          <thead>
            <tr><th>Capa</th><th>Álbum</th><th>Gêneros</th><th>Ano</th><th>Home</th><th>Status</th><th></th></tr>
          </thead>
          <tbody id="albuns-tbody"></tbody>
        </table>
      </div>
      <div class="vazio hidden" id="albuns-vazio">
        <span class="icone">💿</span>
        Nenhum álbum cadastrado ainda.
      </div>
    </div>
  </main>
</div>

<script>
// ==========================================================
// PAINEL PDS — Parte 1: login + listagem real dos álbuns
// ==========================================================
const REPO = 'kleber-albuquerque/pordosom-site';  // ⚠️ na entrega: repo do cliente
const API = 'https://api.github.com';

let TOKEN = localStorage.getItem('pds_token') || '';
let ALBUNS = [];

// ---------- API GitHub ----------
async function gh(caminho, opts = {}) {
  const res = await fetch(API + caminho, {
    ...opts,
    headers: {
      'Authorization': `Bearer ${TOKEN}`,
      'Accept': 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
      ...(opts.headers || {})
    }
  });
  if (res.status === 401) throw new Error('Token inválido ou expirado');
  if (res.status === 403) throw new Error('Sem permissão no repositório (verifique o token)');
  if (!res.ok) throw new Error('Erro GitHub API: ' + res.status);
  return res.json();
}

// ---------- Login ----------
async function entrar() {
  const t = document.getElementById('token').value.trim();
  const err = document.getElementById('login-error');
  err.style.display = 'none';
  if (!t) { err.textContent = 'Cole o token para entrar.'; err.style.display = 'block'; return; }
  TOKEN = t;
  try {
    const user = await gh('/user');           // valida o token
    localStorage.setItem('pds_token', TOKEN);
    document.getElementById('side-user').textContent = 'Conectado: ' + (user.login || user.name);
    abrirPainel();
    await carregarAlbuns();
  } catch (e) {
    TOKEN = '';
    err.textContent = '❌ ' + e.message;
    err.style.display = 'block';
  }
}
document.getElementById('token').addEventListener('keypress', e => {
  if (e.key === 'Enter') entrar();
});
function sair() {
  localStorage.removeItem('pds_token');
  location.reload();
}

// ---------- Navegação ----------
document.querySelectorAll('.side-item[data-pagina]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.side-item').forEach(b => b.classList.remove('ativo'));
    btn.classList.add('ativo');
    ['inicio', 'albuns'].forEach(p =>
      document.getElementById('pagina-' + p).classList.toggle('hidden', p !== btn.dataset.pagina));
  });
});
function emBreve(nome) {
  toast(nome + ': disponível na próxima parte do painel 😉');
}

function abrirPainel() {
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('painel').classList.remove('hidden');
}

// ---------- Parser do frontmatter (mesma lógica do render.py) ----------
function parseMd(texto) {
  const m = texto.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
  if (!m) return { meta: {}, corpo: texto };
  const meta = {}; let lista = null;
  for (const linha of m[1].split('\n')) {
    const mi = linha.match(/^\s+-\s+(\S+)\s*$/);
    if (mi && lista) { meta[lista].push(mi[1]); continue; }
    const mk = linha.match(/^([\w-]+):\s*(.*)$/);
    if (mk) {
      const k = mk[1], v = mk[2].trim(); lista = k;
      const ms = v.match(/^"(.*)"$/) || v.match(/^'(.*)'$/);
      if (ms) meta[k] = ms[1];
      else if (v === '') meta[k] = [];
      else if (v === 'true') meta[k] = true;
      else if (v === 'false') meta[k] = false;
      else if (/^\d+$/.test(v)) meta[k] = parseInt(v);
      else meta[k] = v;
    }
  }
  return { meta, corpo: m[2].trim() };
}

// ---------- Carregar álbuns do repo ----------
async function carregarAlbuns() {
  const loading = document.getElementById('albuns-loading');
  const wrap = document.getElementById('albuns-table-wrap');
  const vazio = document.getElementById('albuns-vazio');
  try {
    const lista = await gh(`/repos/${REPO}/contents/content/albuns`);
    const mds = lista.filter(f => f.name.endsWith('.md'));

    ALBUNS = [];
    for (const f of mds) {
      const blob = await gh(`/repos/${REPO}/contents/content/albuns/${f.name}`);
      const texto = atob(blob.content.replace(/\n/g, ''));
      // UTF-8 correto (o atob trata como latin1):
      const textoUtf8 = decodeURIComponent(escape(texto));
      const { meta } = parseMd(textoUtf8);
      meta._arquivo = f.name;
      meta._sha = blob.sha;
      ALBUNS.push(meta);
    }
    ALBUNS.sort((a, b) => (b.ano || 0) - (a.ano || 0));

    // Stats do início
    document.getElementById('stat-albuns').textContent = ALBUNS.length;
    document.getElementById('stat-destaques').textContent = ALBUNS.filter(a => a.destaque).length;
    const generos = new Set(); ALBUNS.forEach(a => (a.generos || []).forEach(g => generos.add(g)));
    document.getElementById('stat-generos').textContent = generos.size;

    // Tabela
    const tbody = document.getElementById('albuns-tbody');
    tbody.innerHTML = ALBUNS.map(a => `
      <tr>
        <td>${a.capa && !a.capa.includes('uploads')
            ? `<img class="capa-mini" src="${a.capa}" alt="">`
            : `<div class="sem-capa">💿</div>`}</td>
        <td>
          <div class="titulo-cell">${a.titulo || a._arquivo}</div>
          <div class="artista-cell">${a.artista || '—'}</div>
        </td>
        <td>${(a.generos || []).map(g => `<span class="tag-genero">${g}</span>`).join('')}</td>
        <td>${a.ano || '—'}</td>
        <td>${a.destaque ? '<span class="destaque-star">★</span>' : '—'}</td>
        <td><span class="status-publicado"><span class="status-dot status-ok"></span>Publicado</span></td>
        <td><button class="side-item" style="padding:.4rem .7rem" onclick="emBreve('Editor do álbum')">✏️</button></td>
      </tr>`).join('');

    loading.classList.add('hidden');
    if (ALBUNS.length) wrap.classList.remove('hidden'); else vazio.classList.remove('hidden');
    toast('✓ ' + ALBUNS.length + ' álbuns carregados do repositório');
  } catch (e) {
    loading.textContent = '❌ ' + e.message;
    loading.style.color = '#f0b0b0';
  }
}

// ---------- Toast ----------
function toast(msg) {
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3500);
}

// ---------- Auto-login se já tem token ----------
(async function init() {
  if (TOKEN) {
    try {
      const user = await gh('/user');
      document.getElementById('side-user').textContent = 'Conectado: ' + (user.login || user.name);
      abrirPainel();
      carregarAlbuns();
    } catch (e) {
      localStorage.removeItem('pds_token');
      TOKEN = '';
    }
  }
})();
</script>
</body>
</html>
